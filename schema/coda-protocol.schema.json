{
  "$defs": {
    "BackendKind": {"description":"The agent backend that drives a session.\n\nAdding a variant requires a `PROTOCOL_VERSION` bump: older peers reject\nunknown variants rather than ignoring them.","oneOf":[{"const":"claude_code","description":"Claude Code CLI.","type":"string"},{"const":"codex_app_server","description":"Codex through its app server.","type":"string"},{"const":"codex_exec","description":"Codex through one-shot exec runs.","type":"string"},{"const":"anthropic","description":"Anthropic API.","type":"string"},{"const":"openai_compat","description":"Any API compatible with the `OpenAI` chat format.","type":"string"},{"const":"faux","description":"Scripted backend used in tests.","type":"string"}]},
    "DaemonShutdownParams": {"description":"Parameters of [`DAEMON_SHUTDOWN`].","type":"object"},
    "DaemonShutdownResult": {"description":"Result of [`DAEMON_SHUTDOWN`].","type":"object"},
    "DaemonStatusParams": {"description":"Parameters of [`DAEMON_STATUS`].","type":"object"},
    "DaemonStatusResult": {"description":"Result of [`DAEMON_STATUS`].","properties":{"active_turns":{"description":"Turns running right now.","format":"uint32","minimum":0,"type":"integer"},"client_count":{"description":"Connections open right now, including the one asking.","format":"uint32","minimum":0,"type":"integer"},"data_dir":{"description":"Directory holding the daemon's database.","type":"string"},"pid":{"description":"Process id of the daemon.","format":"uint32","minimum":0,"type":"integer"},"protocol_version":{"description":"Protocol version the daemon speaks.","format":"uint32","minimum":0,"type":"integer"},"uptime_secs":{"description":"Seconds since the daemon started.","format":"uint64","minimum":0,"type":"integer"},"version":{"description":"Version of the daemon build.","type":"string"}},"required":["pid","protocol_version","version","uptime_secs","client_count","active_turns","data_dir"],"type":"object"},
    "ErrorObject": {"description":"The error member of a failed [`Response`].","properties":{"code":{"description":"Error code, see the named constants in this module.","format":"int64","type":"integer"},"data":{"description":"Additional error information, if any."},"message":{"description":"Short description of the error.","type":"string"}},"required":["code","message"],"type":"object"},
    "Event": {"description":"One event of a session.\n\nAdding a variant requires a `PROTOCOL_VERSION` bump: older peers reject\nunknown variants rather than ignoring them.","oneOf":[{"description":"A permission request was approved.","properties":{"request_id":{"$ref":"#/$defs/RequestId","description":"The request."},"session_id":{"$ref":"#/$defs/SessionId","description":"Session that raised the request."},"tool":{"description":"Tool the request was for.","type":"string"},"type":{"const":"approve","type":"string"}},"required":["type","session_id","request_id","tool"],"type":"object"},{"description":"A permission request was denied.","properties":{"request_id":{"$ref":"#/$defs/RequestId","description":"The request."},"session_id":{"$ref":"#/$defs/SessionId","description":"Session that raised the request."},"tool":{"description":"Tool the request was for.","type":"string"},"type":{"const":"deny","type":"string"}},"required":["type","session_id","request_id","tool"],"type":"object"},{"description":"A permission request timed out without an answer.","properties":{"request_id":{"$ref":"#/$defs/RequestId","description":"The request."},"session_id":{"$ref":"#/$defs/SessionId","description":"Session that raised the request."},"tool":{"description":"Tool the request was for.","type":"string"},"type":{"const":"timeout","type":"string"}},"required":["type","session_id","request_id","tool"],"type":"object"},{"description":"A turn finished.","properties":{"is_error":{"description":"Whether the turn ended in an error.","type":"boolean"},"session_id":{"$ref":"#/$defs/SessionId","description":"Session of the turn."},"turn_id":{"$ref":"#/$defs/TurnId","description":"The finished turn."},"type":{"const":"result","type":"string"}},"required":["type","session_id","turn_id","is_error"],"type":"object"},{"description":"Token usage reported for a turn.","properties":{"session_id":{"$ref":"#/$defs/SessionId","description":"Session of the turn."},"turn_id":{"$ref":"#/$defs/TurnId","description":"The turn the usage belongs to."},"type":{"const":"usage","type":"string"},"usage":{"$ref":"#/$defs/TokenUsage","description":"Tokens used."}},"required":["type","session_id","turn_id","usage"],"type":"object"},{"description":"Approvals cannot be answered, so risky calls are refused.","properties":{"reason":{"description":"Why no approver is reachable.","type":"string"},"session_id":{"$ref":"#/$defs/SessionId","description":"Affected session."},"type":{"const":"approvals_unavailable","type":"string"}},"required":["type","session_id","reason"],"type":"object"},{"description":"A piece of streamed model text.","properties":{"session_id":{"$ref":"#/$defs/SessionId","description":"Session of the turn."},"text":{"description":"The text fragment.","type":"string"},"turn_id":{"$ref":"#/$defs/TurnId","description":"Turn being streamed."},"type":{"const":"stream_delta","type":"string"}},"required":["type","session_id","turn_id","text"],"type":"object"},{"description":"The backend process ended unexpectedly.","properties":{"exit_code":{"description":"Exit code, when the process exited normally enough to have one.","format":"int32","type":["integer","null"]},"session_id":{"$ref":"#/$defs/SessionId","description":"Affected session."},"type":{"const":"backend_crashed","type":"string"}},"required":["type","session_id"],"type":"object"},{"description":"A running turn was cut short.","properties":{"session_id":{"$ref":"#/$defs/SessionId","description":"Session of the turn."},"turn_id":{"$ref":"#/$defs/TurnId","description":"The interrupted turn."},"type":{"const":"turn_interrupted","type":"string"}},"required":["type","session_id","turn_id"],"type":"object"}]},
    "GrantAddParams": {"description":"Parameters of [`GRANT_ADD`]. A grant matches only when repository, tool,\ncwd and pattern all equal the requested call.","properties":{"cwd":{"description":"Working directory the grant applies to.","type":"string"},"pattern":{"description":"Exact command or argument pattern the grant covers.","type":"string"},"repo_path":{"description":"Canonical root of the git repository the grant applies to.","type":"string"},"tool":{"description":"Tool the grant covers.","type":"string"}},"required":["repo_path","tool","cwd","pattern"],"type":"object"},
    "GrantAddResult": {"description":"Result of [`GRANT_ADD`].","properties":{"granted_at":{"description":"When the grant was first stored, in milliseconds since the Unix epoch.","format":"int64","type":"integer"}},"required":["granted_at"],"type":"object"},
    "Id": {"anyOf":[{"description":"Numeric identifier.","format":"int64","type":"integer"},{"description":"String identifier.","type":"string"},{"description":"Null identifier, used when the request id could not be determined.","type":"null"}],"description":"A request identifier."},
    "InitializeParams": {"description":"Parameters of [`INITIALIZE`].","properties":{"client_name":{"description":"Name of the connecting client.","type":"string"},"protocol_version":{"description":"Protocol version the client speaks.","format":"uint32","minimum":0,"type":"integer"}},"required":["protocol_version","client_name"],"type":"object"},
    "InitializeResult": {"description":"Result of [`INITIALIZE`].","properties":{"daemon_version":{"description":"Version of the daemon build.","type":"string"},"protocol_version":{"description":"Protocol version the daemon speaks.","format":"uint32","minimum":0,"type":"integer"}},"required":["protocol_version","daemon_version"],"type":"object"},
    "Mode": {"description":"How much autonomy the agent has in a session.","oneOf":[{"const":"default","description":"Ask before risky actions.","type":"string"},{"const":"plan","description":"Plan only, make no changes.","type":"string"},{"const":"accept_edits","description":"Apply file edits without asking.","type":"string"}]},
    "Notification": {"description":"A call that expects no response.","properties":{"jsonrpc":{"$ref":"#/$defs/Version","description":"Protocol version marker."},"method":{"description":"Name of the method to invoke.","type":"string"},"params":{"description":"Method parameters, if any."}},"required":["jsonrpc","method"],"type":"object"},
    "OriginalId": {"description":"Identifies a stored original tool output.","type":"string"},
    "PermissionDecision": {"description":"The answer to a permission request.","oneOf":[{"const":"allow_once","description":"Allow this one call.","type":"string"},{"const":"allow_always","description":"Allow this call and matching calls later.","type":"string"},{"const":"deny","description":"Refuse the call.","type":"string"}]},
    "PermissionRespondParams": {"description":"Parameters of [`PERMISSION_RESPOND`].","properties":{"decision":{"$ref":"#/$defs/PermissionDecision","description":"The decision."},"request_id":{"$ref":"#/$defs/RequestId","description":"The request being answered."},"session_id":{"$ref":"#/$defs/SessionId","description":"Session that raised the request."}},"required":["session_id","request_id","decision"],"type":"object"},
    "PermissionRespondResult": {"description":"Result of [`PERMISSION_RESPOND`].","properties":{"accepted":{"description":"Whether the request was still pending and took the decision.","type":"boolean"}},"required":["accepted"],"type":"object"},
    "PingParams": {"description":"Parameters of [`DAEMON_PING`].","type":"object"},
    "PingResult": {"description":"Result of [`DAEMON_PING`].","type":"object"},
    "Request": {"description":"A call that expects a [`Response`].","properties":{"id":{"$ref":"#/$defs/Id","description":"Correlates the response with this request."},"jsonrpc":{"$ref":"#/$defs/Version","description":"Protocol version marker."},"method":{"description":"Name of the method to invoke.","type":"string"},"params":{"description":"Method parameters, if any."}},"required":["jsonrpc","id","method"],"type":"object"},
    "RequestId": {"description":"Identifies one pending permission request.","type":"string"},
    "SessionCancelParams": {"description":"Parameters of [`SESSION_CANCEL`].","properties":{"session_id":{"$ref":"#/$defs/SessionId","description":"Target session."}},"required":["session_id"],"type":"object"},
    "SessionCancelResult": {"description":"Result of [`SESSION_CANCEL`].","properties":{"cancelled":{"description":"Whether a running turn was cancelled.","type":"boolean"}},"required":["cancelled"],"type":"object"},
    "SessionCreateParams": {"description":"Parameters of [`SESSION_CREATE`].","properties":{"backend":{"$ref":"#/$defs/BackendKind","description":"Backend to drive the session."},"cwd":{"description":"Working directory of the session.","type":"string"},"mode":{"$ref":"#/$defs/Mode","default":"default","description":"Initial autonomy mode."},"model":{"description":"Model to use, or the backend default.","type":["string","null"]}},"required":["backend","cwd"],"type":"object"},
    "SessionCreateResult": {"description":"Result of [`SESSION_CREATE`].","properties":{"session":{"$ref":"#/$defs/SessionInfo","description":"The new session."}},"required":["session"],"type":"object"},
    "SessionId": {"description":"Identifies one agent session.","type":"string"},
    "SessionInfo": {"description":"A session as listed to clients.","properties":{"backend":{"$ref":"#/$defs/BackendKind","description":"Backend driving the session."},"cwd":{"description":"Working directory of the session.","type":"string"},"id":{"$ref":"#/$defs/SessionId","description":"Session identifier."},"mode":{"$ref":"#/$defs/Mode","default":"default","description":"Current autonomy mode."},"model":{"description":"Model in use, when one is selected.","type":["string","null"]}},"required":["id","backend","cwd"],"type":"object"},
    "SessionListParams": {"description":"Parameters of [`SESSION_LIST`].","properties":{"cwd":{"description":"Only sessions started in this working directory, or every session when absent.","type":["string","null"]},"limit":{"description":"Most sessions to return; the daemon applies its own default and ceiling.","format":"uint32","minimum":0,"type":["integer","null"]}},"type":"object"},
    "SessionListResult": {"description":"Result of [`SESSION_LIST`], newest session first.","properties":{"sessions":{"description":"The matching sessions.","items":{"$ref":"#/$defs/SessionSummary"},"type":"array"}},"required":["sessions"],"type":"object"},
    "SessionResumeParams": {"description":"Parameters of [`SESSION_RESUME`].","properties":{"session_id":{"$ref":"#/$defs/SessionId","description":"Session to reopen."}},"required":["session_id"],"type":"object"},
    "SessionResumeResult": {"description":"Result of [`SESSION_RESUME`].","properties":{"session":{"$ref":"#/$defs/SessionInfo","description":"The reopened session."}},"required":["session"],"type":"object"},
    "SessionSendParams": {"description":"Parameters of [`SESSION_SEND`].","properties":{"max_turns":{"description":"Most agent turns the session's loop may take, when it is built for this send.","format":"uint32","minimum":0,"type":["integer","null"]},"session_id":{"$ref":"#/$defs/SessionId","description":"Target session."},"text":{"description":"User message text.","type":"string"},"token_cap":{"description":"Most tokens the session's loop may spend, when it is built for this send.","format":"uint64","minimum":0,"type":["integer","null"]}},"required":["session_id","text"],"type":"object"},
    "SessionSendResult": {"description":"Result of [`SESSION_SEND`].","properties":{"turn_id":{"$ref":"#/$defs/TurnId","description":"The turn the message started."}},"required":["turn_id"],"type":"object"},
    "SessionSetModelParams": {"description":"Parameters of [`SESSION_SET_MODEL`].","properties":{"model":{"description":"Model to switch to.","type":"string"},"session_id":{"$ref":"#/$defs/SessionId","description":"Target session."}},"required":["session_id","model"],"type":"object"},
    "SessionSetModelResult": {"description":"Result of [`SESSION_SET_MODEL`].","properties":{"session":{"$ref":"#/$defs/SessionInfo","description":"The session after the switch."}},"required":["session"],"type":"object"},
    "SessionStatus": {"description":"Whether a session has a turn running.","oneOf":[{"const":"idle","description":"No turn is running.","type":"string"},{"const":"running","description":"A turn is starting or running.","type":"string"}]},
    "SessionSubscribeParams": {"description":"Parameters of [`SESSION_SUBSCRIBE`].","properties":{"session_id":{"$ref":"#/$defs/SessionId","description":"Target session."},"since_seq":{"description":"Replay events after this sequence number, or only new events.","format":"uint64","minimum":0,"type":["integer","null"]}},"required":["session_id"],"type":"object"},
    "SessionSubscribeResult": {"description":"Result of [`SESSION_SUBSCRIBE`].","properties":{"subscribed":{"description":"Whether the subscription is active.","type":"boolean"}},"required":["subscribed"],"type":"object"},
    "SessionSummary": {"description":"Metadata of one stored session; never its content.","properties":{"backend":{"$ref":"#/$defs/BackendKind","description":"Backend driving the session."},"created_at":{"description":"Creation time, in milliseconds since the Unix epoch.","format":"int64","type":"integer"},"cwd":{"description":"Working directory of the session.","type":"string"},"id":{"$ref":"#/$defs/SessionId","description":"Session identifier."},"status":{"$ref":"#/$defs/SessionStatus","description":"Whether a turn is running."},"updated_at":{"description":"Time of the last event, or the creation time when there is none.","format":"int64","type":"integer"}},"required":["id","backend","cwd","created_at","updated_at","status"],"type":"object"},
    "TokenUsage": {"description":"Token counts for a turn or a whole session.","properties":{"cache_read_tokens":{"default":0,"description":"Input tokens served from the prompt cache.","format":"uint64","minimum":0,"type":"integer"},"cache_write_tokens":{"default":0,"description":"Input tokens written to the prompt cache.","format":"uint64","minimum":0,"type":"integer"},"input_tokens":{"default":0,"description":"Tokens sent to the model.","format":"uint64","minimum":0,"type":"integer"},"output_tokens":{"default":0,"description":"Tokens produced by the model.","format":"uint64","minimum":0,"type":"integer"}},"type":"object"},
    "TurnId": {"description":"Identifies one turn within a session.","type":"string"},
    "UsageSummaryParams": {"description":"Parameters of [`USAGE_SUMMARY`].","properties":{"session_id":{"anyOf":[{"$ref":"#/$defs/SessionId"},{"type":"null"}],"description":"Session to summarize, or every session when absent."}},"type":"object"},
    "UsageSummaryResult": {"description":"Result of [`USAGE_SUMMARY`].","properties":{"saved_bytes":{"default":0,"description":"Bytes of tool output the token economy kept out of the context.","format":"uint64","minimum":0,"type":"integer"},"usage":{"$ref":"#/$defs/TokenUsage","description":"Total usage of the summarized sessions."}},"required":["usage"],"type":"object"},
    "Version": {"const":"2.0"}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "event": {"$ref":"#/$defs/Event"},
  "methods": {
    "daemon.ping": {"params":{"$ref":"#/$defs/PingParams"},"result":{"$ref":"#/$defs/PingResult"}},
    "daemon.shutdown": {"params":{"$ref":"#/$defs/DaemonShutdownParams"},"result":{"$ref":"#/$defs/DaemonShutdownResult"}},
    "daemon.status": {"params":{"$ref":"#/$defs/DaemonStatusParams"},"result":{"$ref":"#/$defs/DaemonStatusResult"}},
    "grant.add": {"params":{"$ref":"#/$defs/GrantAddParams"},"result":{"$ref":"#/$defs/GrantAddResult"}},
    "initialize": {"params":{"$ref":"#/$defs/InitializeParams"},"result":{"$ref":"#/$defs/InitializeResult"}},
    "permission.respond": {"params":{"$ref":"#/$defs/PermissionRespondParams"},"result":{"$ref":"#/$defs/PermissionRespondResult"}},
    "session.cancel": {"params":{"$ref":"#/$defs/SessionCancelParams"},"result":{"$ref":"#/$defs/SessionCancelResult"}},
    "session.create": {"params":{"$ref":"#/$defs/SessionCreateParams"},"result":{"$ref":"#/$defs/SessionCreateResult"}},
    "session.list": {"params":{"$ref":"#/$defs/SessionListParams"},"result":{"$ref":"#/$defs/SessionListResult"}},
    "session.resume": {"params":{"$ref":"#/$defs/SessionResumeParams"},"result":{"$ref":"#/$defs/SessionResumeResult"}},
    "session.send": {"params":{"$ref":"#/$defs/SessionSendParams"},"result":{"$ref":"#/$defs/SessionSendResult"}},
    "session.set_model": {"params":{"$ref":"#/$defs/SessionSetModelParams"},"result":{"$ref":"#/$defs/SessionSetModelResult"}},
    "session.subscribe": {"params":{"$ref":"#/$defs/SessionSubscribeParams"},"result":{"$ref":"#/$defs/SessionSubscribeResult"}},
    "usage.summary": {"params":{"$ref":"#/$defs/UsageSummaryParams"},"result":{"$ref":"#/$defs/UsageSummaryResult"}}
  },
  "title": "coda protocol",
  "x-protocol-version": 1
}
