+++ b/src/cache.rs
@@ -0,0 +1,13 @@
+use std::collections::HashMap;
+use std::sync::Mutex;
+
+pub struct Cache {
+    items: Mutex<HashMap<String, String>>,
+}
+
+impl Cache {
+    pub fn get(&self, key: &str) -> Option<String> {
+        let items = self.items.lock().unwrap();
+        items.get(key).cloned()
+    }
+}
